# wdx-hub as a system service, with /usr/local/bin/wdx-hub from its release
# archive. README.md says how to install it.
[Unit]
Description=wdx hub
Documentation=https://github.com/srjn45/wdx/tree/main/deploy/hub
Wants=network-online.target
After=network-online.target

[Service]
ExecStart=/usr/local/bin/wdx-hub serve
DynamicUser=yes
StateDirectory=wdx-hub
Environment=WDX_HUB_HOME=/var/lib/wdx-hub
# Settings, public_url first, are in /var/lib/wdx-hub/config.yaml, written by
# wdx-hub setting set; one given here as WDX_HUB_<KEY> wins over the file.
Restart=on-failure

[Install]
WantedBy=multi-user.target
