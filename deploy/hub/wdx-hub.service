# wdx-hub as a system service, as install-hub.sh installs it: wdx-hub service unit
# prints this file, and wdx-hub update writes it anew from each release.
[Unit]
Description=wdx hub
Documentation=https://github.com/srjn45/wdx/tree/main/deploy/hub
Wants=network-online.target
After=network-online.target

[Service]
ExecStart=/usr/local/bin/wdx-hub serve
User=wdx-hub
Group=wdx-hub
# The user's home directory is /var/lib/wdx-hub, and the hub's home the
# default in it, /var/lib/wdx-hub/.wdx-hub. Its settings are in config.yaml
# there, written by sudo wdx-hub setting set; one given here as WDX_HUB_<KEY>
# wins over the file.
StateDirectory=wdx-hub
StateDirectoryMode=0700
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
CapabilityBoundingSet=
Restart=on-failure

[Install]
WantedBy=multi-user.target
