---
// A guide's commands, from its frontmatter's commands, each with its summary
// and a link to its reference section, as scripts/sitegen wrote them.
import commands from '../data/commands.json';

const listed: string[] = Astro.locals.starlightRoute.entry.data.commands ?? [];
const rows = listed.map((path) => {
  const c = (commands as Record<string, { summary: string; href: string }>)[path];
  if (!c) throw new Error(`<Commands />: ${path} is not a wdx command`);
  return { path, ...c };
});
---
<table>
  <thead><tr><th>Command</th><th>What it does</th></tr></thead>
  <tbody>
    {rows.map((r) => (
      <tr><td><a href={r.href}><code>wdx {r.path}</code></a></td><td>{r.summary}</td></tr>
    ))}
  </tbody>
</table>
