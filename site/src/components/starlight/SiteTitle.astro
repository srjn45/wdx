---
// Starlight's header, left side: the site's wordmark and the landing page's
// links, so the blog and the landing page read as one site.
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<div class="wdx-title">
  <a class="logo" href={`${base}/`} aria-label="wdx home">
    <svg viewBox="0 0 192 94" aria-hidden="true">
      <polyline points="12,38 28,82 46,46 64,82 80,38" fill="none" stroke="currentColor" stroke-width="11" stroke-linecap="round" stroke-linejoin="round" />
      <circle cx="116" cy="62" r="20" fill="none" stroke="currentColor" stroke-width="11" />
      <line x1="136" y1="20" x2="136" y2="82" stroke="currentColor" stroke-width="11" stroke-linecap="round" />
      <line x1="152" y1="12" x2="180" y2="40" class="x" stroke-width="10" stroke-linecap="round" />
      <line x1="180" y1="12" x2="152" y2="40" class="x" stroke-width="10" stroke-linecap="round" />
    </svg>
  </a>
  <nav aria-label="Site">
    <a href={`${base}/#tide`}>tide</a>
    <a href={`${base}/#features`}>Features</a>
    <a href="https://github.com/srjn45/wdx#readme">Docs</a>
  </nav>
</div>
