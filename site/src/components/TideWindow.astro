---
// A terminal window around a live tide demo. The demo draws into the .sim
// element; slot "bar" goes in the title bar, the default slot under it.
interface Props { simId: string; titleId: string; title: string; }
const { simId, titleId, title } = Astro.props;
---
<div class="wbar"><i></i><i></i><i></i><span class="t" id={titleId}>{title}</span><slot name="bar" /></div>
<div class="sim" id={simId} aria-describedby={`${simId}-cap`}></div>
<slot />
