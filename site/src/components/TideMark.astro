---
// tide's mark: a terminal window with a prompt chevron and a block cursor,
// drawn as the wdx mark is, one monoline with round ends. The ink follows
// the text colour; the chevron takes the brand colour.
interface Props { class?: string; }
const { class: cls } = Astro.props;
---
<svg class={cls} viewBox="0 10 100 80" aria-hidden="true">
  <rect x="10" y="18" width="80" height="64" rx="10" fill="none" stroke="currentColor" stroke-width="8" />
  <polyline points="30,40 44,52 30,64" fill="none" class="x" stroke-width="8" stroke-linecap="round" stroke-linejoin="round" />
  <rect x="53" y="43" width="14" height="22" rx="2" fill="currentColor" />
</svg>
