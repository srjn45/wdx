---
// The theme is kept under Starlight's key, so the blog keeps it too.
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<header class="nav band"><div class="wrap">
  <a class="logo" href={`${base}/`} aria-label="wdx home">
    <svg viewBox="0 0 192 94" aria-hidden="true">
      <polyline points="12,38 28,82 46,46 64,82 80,38" fill="none" stroke="currentColor" stroke-width="11" stroke-linecap="round" stroke-linejoin="round" />
      <circle cx="116" cy="62" r="20" fill="none" stroke="currentColor" stroke-width="11" />
      <line x1="136" y1="20" x2="136" y2="82" stroke="currentColor" stroke-width="11" stroke-linecap="round" />
      <line x1="152" y1="12" x2="180" y2="40" class="x" stroke-width="10" stroke-linecap="round" />
      <line x1="180" y1="12" x2="152" y2="40" class="x" stroke-width="10" stroke-linecap="round" />
    </svg>
  </a>
  <nav aria-label="Main">
    <a href={`${base}/#tide`}>tide</a>
    <a href={`${base}/#features`}>Features</a>
    <a href={`${base}/#how`}>How it works</a>
    <a href={`${base}/docs/`}>Docs</a>
    <a href={`${base}/blog/`}>Blog</a>
  </nav>
  <span class="sp"></span>
  <button class="theme" type="button" id="theme" aria-label="Switch between dark and light">◐</button>
  <a class="btn" href="https://github.com/srjn45/wdx">GitHub</a>
  <a class="btn primary" href={`${base}/#install`}>Install</a>
</div></header>
<script>
  const root = document.documentElement;
  document.getElementById('theme')?.addEventListener('click', () => {
    const dark = root.dataset.theme ? root.dataset.theme === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
    root.dataset.theme = dark ? 'light' : 'dark';
    try { localStorage.setItem('starlight-theme', root.dataset.theme); } catch (_) {}
  });
</script>
