---
import TideWindow from './TideWindow.astro';
interface Props { version: string; install: string; }
const { version, install } = Astro.props;
---
<div class="hero band">
  <div class="wrap">
    <div class="chips"><span class="chip"><b>●</b> v{version}</span><span class="chip">Linux · macOS</span><span class="chip">Apache-2.0</span></div>
    <h1>Run a team of AI coding agents from <em>one terminal</em>.</h1>
    <p class="lede">wdx keeps Claude Code, Codex, Cursor and Antigravity agents running in their own git worktrees, long after your terminal closes. tide, its terminal IDE, shows all of them in one window, with their diffs, plans and code.</p>
    <div class="install"><div class="cmd"><span>$</span> {install}</div><button type="button" class="copy" data-copy={install}>Copy</button></div>
    <div class="ctas"><a class="btn primary" href="#install">Get started</a><a class="btn" href="#tide">See tide</a><a class="btn" href="#how">How it works</a></div>
  </div>
  <div class="stage wrap">
    <div class="window">
      <TideWindow simId="hero-sim" titleId="hero-title" title="wdx tide · shop-api">
        <div class="capbar" id="capbar"><span class="dot" aria-hidden="true"></span><span class="cap" id="hero-sim-cap" aria-live="polite">Loading tide…</span><button type="button" class="go" id="drive">Take the wheel</button><button type="button" id="replay">Replay the tour</button></div>
      </TideWindow>
    </div>
    <div class="keys"><span><kbd>↑</kbd> <kbd>↓</kbd> <kbd>Enter</kbd> rows</span><span><kbd>Alt</kbd>+<kbd>←→↑↓</kbd> panes</span><span><kbd>Ctrl</kbd>+<kbd>]</kbd> zoom</span><span><kbd>Ctrl</kbd>+<kbd>\</kbd> terminal</span><span><kbd>Ctrl</kbd>+<kbd>Space</kbd> menu (<kbd>C-q</kbd> in tide)</span><span>click, scroll and type anywhere</span></div>
    <p class="mobile-note">tide is a wide-screen tool: swipe the window sideways to see all of it.</p>
    <p class="demo-note">A replica of tide, scripted in your browser: no AI CLI, daemon or git runs here.</p>
  </div>
</div>
