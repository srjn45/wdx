---
// The main packages and the one way their dependencies point (AGENTS.md).
import Diagram from './Diagram.astro';
---
<Diagram id="pk" width={720} height={420}
  label="The packages and the way their dependencies point. cmd/wdx uses cli. cli reaches the daemon only through client, which speaks the API generated from api/openapi.yaml; tide uses client too. cli also runs the daemon and the termview pane. The daemon serves the API on top of the domain packages: project, terminal, agent, message, worktree, doc and plan. They use db, git and gh, fswatch, aca and holder. The holder uses pty and screen, and aca uses screen."
  caption="Arrows point from a package to what it uses, never back. The cli runs the daemon but never calls the domain: every command goes through the API. Every package may use identity and logging.">
  <rect class="bx" x="20" y="20" width="110" height="44" rx="8" /><text x="34" y="47">cmd/wdx</text>
  <rect class="bx hot" x="170" y="20" width="110" height="44" rx="8" /><text x="184" y="47">cli</text>
  <rect class="bx hot" x="330" y="20" width="110" height="44" rx="8" /><text x="344" y="47">client</text>
  <rect class="bx hot" x="480" y="20" width="220" height="44" rx="8" /><text x="494" y="40">api</text><text class="sm" x="494" y="56">from openapi.yaml</text>
  <rect class="bx" x="20" y="110" width="110" height="44" rx="8" /><text x="34" y="137">daemon</text>
  <rect class="bx" x="170" y="110" width="110" height="44" rx="8" /><text x="184" y="137">termview</text>
  <rect class="bx" x="330" y="110" width="110" height="44" rx="8" /><text x="344" y="137">tide</text>
  <rect class="bx" x="20" y="200" width="300" height="110" rx="10" /><text x="34" y="226">domain</text>
  <text class="sm" x="34" y="250">project · terminal · agent</text><text class="sm" x="34" y="270">message · worktree</text><text class="sm" x="34" y="290">doc · plan · a package each</text>
  <rect class="bx" x="480" y="200" width="110" height="44" rx="8" /><text x="494" y="227">holder</text>
  <rect class="bx" x="610" y="200" width="100" height="44" rx="8" /><text x="624" y="227">pty</text>
  <rect class="bx" x="610" y="290" width="100" height="44" rx="8" /><text x="624" y="317">screen</text>
  <rect class="bx" x="20" y="356" width="110" height="44" rx="8" /><text x="34" y="383">db</text>
  <rect class="bx" x="150" y="356" width="110" height="44" rx="8" /><text x="164" y="383">git · gh</text>
  <rect class="bx" x="280" y="356" width="110" height="44" rx="8" /><text x="294" y="383">fswatch</text>
  <rect class="bx" x="410" y="356" width="110" height="44" rx="8" /><text x="424" y="383">aca</text>
  <path class="ar" d="M130 42 L166 42" marker-end="url(#pk-a)" />
  <path class="ar hot" d="M280 42 L326 42" marker-end="url(#pk-h)" /><path class="ar hot" d="M440 42 L476 42" marker-end="url(#pk-h)" />
  <path class="ar dash" d="M190 64 L110 106" marker-end="url(#pk-a)" /><text class="sm" x="48" y="84">runs it</text>
