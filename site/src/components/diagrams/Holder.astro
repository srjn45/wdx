---
// Inside a holder: the PTY's output to the spool, the vt and history, and to
// the attached clients; messages from the daemon into the PTY.
import Diagram from './Diagram.astro';
---
<Diagram id="ho" width={720} height={410}
  label="Inside a holder. The shell or AI CLI writes to its PTY. The holder's reader drains the PTY and sends each chunk to the spool on disk and, live, to every attached client. The vt reads the spool and keeps the screen; lines that scroll off go to history. The daemon holds a control connection to the holder, to start, stop and send messages, which wait in the inbox until they can go into the PTY. Attached clients type into the PTY through the holder's socket."
  caption="One holder per terminal or agent. The reader never waits for the vt or a client, so the shell never blocks on either.">
  <rect class="grp" x="200" y="10" width="510" height="280" rx="12" /><text class="ttl" x="214" y="30">wdx holder · one per terminal</text>
  <rect class="bx" x="10" y="20" width="160" height="54" rx="8" /><text x="24" y="44">wdx daemon</text><text class="sm" x="24" y="62">control connection</text>
  <text class="sm" x="14" y="94">start · stop · send</text>
  <rect class="bx" x="10" y="140" width="110" height="54" rx="8" /><text x="24" y="164">shell or ACA</text><text class="sm" x="24" y="182">zsh · claude</text>
  <rect class="bx hot" x="140" y="140" width="56" height="54" rx="8" /><text x="152" y="172">PTY</text>
  <rect class="bx" x="220" y="44" width="130" height="54" rx="8" /><text x="234" y="68">inbox</text><text class="sm" x="234" y="86">messages wait</text>
  <rect class="bx hot" x="220" y="140" width="130" height="54" rx="8" /><text x="234" y="164">reader</text><text class="sm" x="234" y="182">always drains</text>
  <rect class="bx hot" x="380" y="140" width="170" height="54" rx="8" /><text x="394" y="164">spool</text><text class="sm" x="394" y="182">raw output · 8 MiB</text>
  <rect class="bx hot" x="580" y="140" width="120" height="54" rx="8" /><text x="594" y="164">vt</text><text class="sm" x="594" y="182">the screen</text>
  <rect class="bx" x="566" y="44" width="138" height="54" rx="8" /><text x="580" y="68">history</text><text class="sm" x="580" y="86">files of 10,000</text>
  <rect class="bx dim" x="580" y="222" width="120" height="54" rx="8" /><text x="594" y="246">parser</text><text class="sm" x="594" y="264">agents only</text>
  <rect class="bx" x="380" y="330" width="250" height="54" rx="8" /><text x="394" y="354">attached clients</text><text class="sm" x="394" y="372">TIDE · wdx terminal attach</text>
  <path class="ar" d="M120 167 L136 167" marker-start="url(#ho-a)" marker-end="url(#ho-a)" />
  <path class="ar hot" d="M196 167 L216 167" marker-end="url(#ho-h)" />
  <path class="ar hot" d="M350 167 L376 167" marker-end="url(#ho-h)" />
  <path class="ar hot" d="M550 167 L576 167" marker-end="url(#ho-h)" />
  <path class="ar" d="M640 140 L640 102" marker-end="url(#ho-a)" /><text class="sm" x="540" y="124">scrolled off</text>
  <path class="ar" d="M640 194 L640 218" marker-end="url(#ho-a)" />
  <path class="ar" d="M170 47 L216 64" marker-start="url(#ho-a)" marker-end="url(#ho-a)" />
  <path class="ar" d="M220 92 L180 136" marker-end="url(#ho-a)" />
  <path class="ar" d="M285 194 V356 H376" marker-end="url(#ho-a)" /><text class="sm" x="292" y="320">live</text>
  <path class="ar" d="M380 374 H168 V198" marker-end="url(#ho-a)" /><text class="sm" x="200" y="392">keys</text>
  <rect class="lbl" x="400" y="300" width="160" height="18" rx="3" /><text class="sm" x="406" y="313">run/&lt;id&gt;.sock</text>
</Diagram>
