---
// A diagram showing how a plan breaks a feature into a DAG of tasks,
// runs them in parallel slots, synthesizes context, and lands finished tasks.
import Diagram from '../diagrams/Diagram.astro';
---
<Diagram id="pd" width={720} height={380}
  label="Flowchart of a wdx plan: A plan YAML defines a DAG of tasks (schema unblocks api and cli, which unblock docs). Tasks run in isolated slots (.worktrees/plan-1 and plan-2), synthesized with the goal, constraints, and summaries of completed tasks. When done, each task is verified, passes the project landing check, and is atomically rebased onto the plan branch."
  caption="How wdx executes a plan: tasks run in parallel slots as dependencies clear, receive synthesized context from finished tasks, and rebase atomically onto the plan branch.">

  <!-- Column 1: DAG Tasks -->
  <text class="ttl" x="14" y="22">1. The DAG</text>
  <rect class="grp" x="10" y="34" width="180" height="332" rx="10" />

  <!-- schema -->
  <rect class="bx" x="24" y="52" width="152" height="48" rx="8" />
  <text x="38" y="74">schema</text>
  <text class="sm hot" x="38" y="91">✓ landed</text>

  <!-- api -->
  <rect class="bx hot" x="24" y="132" width="152" height="54" rx="8" />
  <text class="hot" x="38" y="154">api</text>
  <text class="sm" x="38" y="172">after: [schema]</text>

  <!-- cli -->
  <rect class="bx hot" x="24" y="212" width="152" height="54" rx="8" />
  <text class="hot" x="38" y="234">cli</text>
  <text class="sm" x="38" y="252">after: [schema]</text>

  <!-- docs -->
  <rect class="bx dim" x="24" y="294" width="152" height="54" rx="8" />
  <text x="38" y="316">docs</text>
  <text class="sm" x="38" y="334">after: [api, cli]</text>

  <!-- DAG arrows inside Col 1 -->
  <path class="ar hot" d="M100 100 V128" marker-end="url(#pd-h)" />
  <path class="ar hot" d="M100 186 V208" marker-end="url(#pd-h)" />
  <path class="ar dash" d="M100 266 V290" marker-end="url(#pd-a)" />

  <!-- Column 2: Slots & Context Synthesis -->
  <text class="ttl" x="214" y="22">2. Parallel Slots &amp; Context</text>
  <rect class="grp" x="206" y="34" width="280" height="332" rx="10" />

  <!-- Context box -->
  <rect class="bx" x="220" y="52" width="252" height="92" rx="8" />
  <text class="ttl" x="232" y="72">Prompt synthesis</text>
  <text class="sm" x="232" y="92">● Plan Goal &amp; Constraints</text>
  <text class="sm" x="232" y="110">● Summaries of 'after' tasks</text>
  <text class="sm" x="232" y="128">● Task prompt + plan task done</text>

  <!-- Slot 1 -->
  <rect class="bx hot" x="220" y="162" width="252" height="74" rx="8" />
  <text class="hot" x="234" y="186">Slot 1 · .worktrees/auth-1</text>
  <text class="sm" x="234" y="206">Task: api (claude_code / sonnet)</text>
  <text class="sm hot" x="234" y="224">● working</text>

  <!-- Slot 2 -->
  <rect class="bx hot" x="220" y="254" width="252" height="74" rx="8" />
  <text class="hot" x="234" y="278">Slot 2 · .worktrees/auth-2</text>
  <text class="sm" x="234" y="298">Task: cli (codex / gpt-5)</text>
  <text class="sm hot" x="234" y="316">● working</text>

  <!-- Arrow from DAG to Slots -->
  <path class="ar hot" d="M176 159 H216" marker-end="url(#pd-h)" />
  <path class="ar hot" d="M176 239 H216" marker-end="url(#pd-h)" />

  <!-- Column 3: Landing -->
  <text class="ttl" x="510" y="22">3. Landing to Branch</text>
  <rect class="grp" x="502" y="34" width="208" height="332" rx="10" />

  <rect class="bx" x="516" y="52" width="180" height="50" rx="8" />
  <text class="sm" x="528" y="74">plan task done</text>
  <text class="sm" x="528" y="91">checks clean commit</text>

  <rect class="bx" x="516" y="120" width="180" height="54" rx="8" />
  <text class="sm" x="528" y="142">landing check</text>
  <text class="sm" x="528" y="160">runs in land-slot</text>

  <rect class="bx hot" x="516" y="192" width="180" height="54" rx="8" />
  <text class="sm hot" x="528" y="214">atomic rebase</text>
  <text class="sm" x="528" y="232">onto plan/auth</text>

  <rect class="bx" x="516" y="278" width="180" height="70" rx="8" />
  <text x="528" y="302">plan/auth branch</text>
  <text class="sm hot" x="528" y="322">↑ 3 commits ahead</text>
  <text class="sm" x="528" y="338">ready to land on main</text>

  <!-- Arrows in Col 3 -->
  <path class="ar hot" d="M472 199 H512" marker-end="url(#pd-h)" />
  <path class="ar" d="M606 102 V116" marker-end="url(#pd-a)" />
  <path class="ar hot" d="M606 174 V188" marker-end="url(#pd-h)" />
  <path class="ar hot" d="M606 246 V274" marker-end="url(#pd-h)" />
</Diagram>
