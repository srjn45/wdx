---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import WorksWith from '../components/WorksWith.astro';
import InsideTide from '../components/InsideTide.astro';
import Features from '../components/Features.astro';
import Cli from '../components/Cli.astro';
import Architecture from '../components/Architecture.astro';
import Hub from '../components/Hub.astro';
import Install from '../components/Install.astro';
import BlogBand from '../components/BlogBand.astro';
import { latestRelease, installCommand } from '../release.js';
import '../styles/landing.css';

const version = latestRelease();
---
<Base title="wdx · run a team of AI coding agents from one terminal" description="wdx runs Claude Code, Codex, Cursor and Antigravity agents in their own git worktrees, long after your terminal closes. TIDE, its Terminal IDE, shows all of them in one window, with their diffs, plans and code.">
  <div data-version={version}>
    <Hero version={version} install={installCommand} />
    <WorksWith />
    <InsideTide />
    <Features />
    <Cli />
    <Architecture />
    <Hub />
    <BlogBand />
    <Install install={installCommand} />
  </div>
</Base>
<script>
  import '../scripts/landing.js';
</script>
